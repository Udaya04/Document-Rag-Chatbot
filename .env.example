# MongoDB Atlas connection string (paste your real URI into .env, never commit it).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0

# Name of the database inside your Atlas cluster.
MONGODB_DB_NAME=rag_pipeline

# Groq API key (used in later phases; unused in Phase 0).
GROQ_API_KEY=
